# Copy to .env for local development. .env is gitignored.
#
# ── Do not put a shared AWS key in here ────────────────────────────────────
#
# This app needs exactly one AWS permission. Give it its own key, scoped to
# that, and never reuse a credential that other systems depend on — rotating
# a shared key later means chasing down every place it's used.
#
#   IAM → Users → Create user → e.g. "sakredbody-bedrock"
#   Attach an inline policy:
#
#   {
#     "Version": "2012-10-17",
#     "Statement": [{
#       "Effect": "Allow",
#       "Action": "bedrock:InvokeModel",
#       "Resource": "arn:aws:bedrock:us-west-2::foundation-model/zai.glm-5"
#     }]
#   }
#
# ── Better still: don't put a secret in a file at all ──────────────────────
#
# Configure a named profile once:
#
#   aws configure --profile sakred-bedrock
#
# then set only this, and the SDK reads the credential from ~/.aws:
#
# AWS_PROFILE="sakred-bedrock"

AWS_REGION="us-west-2"

# Only if you aren't using a profile. Dedicated key, never a shared one.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# The model. Defaults to this; here so it's visible.
# SAKRED_DAILY_MODEL="zai.glm-5"

# Needed only to run the app itself (npm run dev). The Bedrock smoke test
# doesn't touch the database.
# SAKREDBODY_DATABASE_URL=""
