<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Voice memos in the community. Runtime-requested on Android 6+; the
         WebView still needs the manifest declaration or getUserMedia fails
         before any prompt is shown. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Health Connect.
         The permissions themselves, the com.google.android.apps.healthdata
         queries block and the rationale activity all come from the plugin's
         own manifest and are merged in. What it cannot do for us is remove
         what we do not use.

         History is deliberately NOT among what we ask for. Health Connect
         reads back thirty days without READ_HEALTH_DATA_HISTORY, and nothing
         in the product reads a member's health further than that: Terrain
         baselines on 28 days, and every summary a member or a coach can open
         asks for 30. Asking to reach past every surface we draw is the
         excessive scope Play rejected 59 for, and "an iPhone member's first
         sync goes deeper" is a parity argument, not a member-facing need.
         client/src/lib/health.ts clamps the Android read to match.

         Removing what we do not use. The plugin declares read AND write for
            every type it supports, so a merged manifest asks for 23 write
            permissions from an app that never writes, plus reads for blood
            pressure, blood glucose and basal metabolic rate that nothing in
            client/src/lib/healthMetrics.ts requests.

            That matters beyond tidiness. Google's Health apps declaration form
            requires a written justification per data type, and the honest
            justification for these is "we do not use it", which is not an
            answer that passes. Anything listed here is a permission we would
            have to defend and could not. -->
    <uses-permission android:name="android.permission.health.WRITE_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_VO2_MAX" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" tools:node="remove" />

    <!-- Reads we never perform. Blood pressure and blood glucose in particular
         push an app toward the medical categories on the declaration form. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" tools:node="remove" />

    <!-- 3. Reads we performed and could not justify.

            Play rejected versionCode 59 under the minimum-scope rule and named
            six: body fat, floors climbed, height, nutrition, total calories
            burned, VO2 max. All six were read, folded into a daily value and
            shown on the health screen if the member's device happened to
            record them. That is the whole feature — we asked because we could,
            and rendered whatever came back.

            Body temperature, blood oxygen and respiratory rate are here too,
            and Google did not name them. They are the same thing: a tile, and
            nothing downstream. Removing only the six that were caught answers
            the letter and leaves the rule for the next review to find.

            What stays is what something other than the health screen consumes.
            Sleep, resting heart rate and HRV decide Terrain. Exercise
            sessions, distance and active calories become the day's movement
            and its training load. Steps, hydration and mindfulness are targets
            a member sets for themselves. Weight is the bodyweight in a
            bodyweight-factor lift — without it a set of pull-ups carries no
            load at all.

            The client half of this is `APPLE_ONLY` in
            client/src/lib/healthMetrics.ts, which keeps Health Connect from
            being asked; HealthReader.kt no longer reads them in the
            background. This block is what keeps the *permission* out of the
            merged manifest, since the declarations come from
            @capgo/capacitor-health and it declares every type it supports. -->
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_NUTRITION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" tools:node="remove" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- The home-screen widget. Reads what the app wrote to SharedPreferences
             on its last sync; see SakredWidgetProvider. -->
        <receiver
            android:name=".SakredWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sakred_info" />
        </receiver>

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!--
            What a coaching notification looks like in the tray.

            Without these, Firebase falls back to the launcher icon, which
            Android reduces to its alpha channel — a solid white square. The
            channel is created at runtime rather than declared here, so its name
            and description are written once, in the same place as the copy the
            member reads.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_sakred" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/sakredNotification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="coaching" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
