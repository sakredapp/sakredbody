<?xml version="1.0" encoding="utf-8"?>
<!--
    The app has one appearance, and it is dark.

    What was here was Capacitor's template: `AppTheme` on
    Theme.AppCompat.Light.DarkActionBar, and `AppTheme.NoActionBar` on
    DayNight with `android:background` set to @null. That is the right default
    for an app that follows the system, and wrong for this one — there is no
    light version of Sakred Body to follow the system *into*. On a phone in
    light mode the window behind the WebView resolved to white, which showed
    as a flash in the gap between the splash drawable being torn down and the
    web layer painting its first frame. Short, and the first thing anyone sees.

    So: a dark base, an explicit `windowBackground` of the same ink the web
    layer uses, and force-dark off — that last one because Android's automatic
    dark mode will otherwise invert a WebView it thinks is a light page, and it
    guesses wrong on a canvas-heavy screen.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/sakredInk</item>
        <item name="android:colorBackground">@color/sakredInk</item>
        <!-- The web layer renders its own dark theme. Letting the platform
             also "helpfully" darken it produces a double inversion. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Not @null. A null window background is what let the system default
             (white, in light mode) show through in the first place. -->
        <item name="android:windowBackground">@color/sakredInk</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@color/sakredInk</item>
    </style>
</resources>
