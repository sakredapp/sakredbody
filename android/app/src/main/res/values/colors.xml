<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's ground, for the native side of the launch.

    hsl(30 10% 10%) is the ink token in client/src/index.css, the ground
    under every surface in the product. The splash PNGs Capacitor generated
    are already this colour; this exists so the *window* underneath them is
    too. Between the splash drawable being torn down and the WebView painting
    its first frame there is a window with its own background, and on a
    light-mode device that background was white.
-->
<resources>
    <color name="sakredInk">#1C1A17</color>
    <!--
        The tint behind the status-bar mark, and the accent Android draws on the
        expanded notification. hsl(39 48% 56%) is the gold token in
        client/src/index.css, so the tray matches the app it came from rather
        than falling back to the system accent, which on most devices is blue.

        (Written without a double hyphen on purpose: XML forbids one inside a
        comment, and naming the CSS variable literally fails the resource merge.)
    -->
    <color name="sakredNotification">#C59F59</color>
</resources>
